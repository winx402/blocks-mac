// Non-secret Debug signing defaults. A local file may override these values.
CODE_SIGN_STYLE = Manual
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
BLOCKS_SELECTION_HELPER_DOWNLOAD_URL =

// Local credentials are never committed. The Debug App Keychain groups require
// Apple Development signing and a matching provisioning profile; these ad-hoc
// defaults alone cannot build the full App.
#include? "Signing.local.xcconfig"
