{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "diagnostics.export.button": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export…"}},"ja":{"stringUnit":{"state":"translated","value":"書き出す…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出…"}}}},
    "diagnostics.export.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Creates a local JSON report with app and system versions, permission states, and redacted audit event types. It excludes clipboard content, screenshots, credentials, endpoints, file paths, and raw logs. Review the file before sending it."}},"ja":{"stringUnit":{"state":"translated","value":"アプリとシステムのバージョン、権限状態、匿名化した監査イベント種別を含むローカル JSON を作成します。クリップボード内容、スクリーンショット、認証情報、接続先、ファイルパス、生ログは含みません。送信前に内容を確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在本地生成 JSON，仅含应用与系统版本、权限状态和脱敏后的审计事件类型；不含剪贴板内容、截图、凭据、服务地址、文件路径和原始日志。请在提交前自行检查。"}}}},
    "diagnostics.export.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The diagnostic report could not be saved."}},"ja":{"stringUnit":{"state":"translated","value":"診断レポートを保存できませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"诊断报告未能保存。"}}}},
    "diagnostics.export.inProgress": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preparing the local diagnostic report…"}},"ja":{"stringUnit":{"state":"translated","value":"ローカル診断レポートを作成しています…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在生成本地诊断报告…"}}}},
    "diagnostics.export.panelTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export Redacted Diagnostics"}},"ja":{"stringUnit":{"state":"translated","value":"匿名化した診断を書き出す"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出脱敏诊断"}}}},
    "diagnostics.export.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagnostic Export"}},"ja":{"stringUnit":{"state":"translated","value":"診断の書き出し"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"诊断导出"}}}},
    "diagnostics.export.succeeded": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved locally. No data was uploaded."}},"ja":{"stringUnit":{"state":"translated","value":"ローカルに保存しました。データは送信されていません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存到本地，没有上传任何数据。"}}}},
    "diagnostics.export.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Redacted Diagnostic Report"}},"ja":{"stringUnit":{"state":"translated","value":"匿名化した診断レポート"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"脱敏诊断报告"}}}},
    "release.channel.appStoreBeta": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"TestFlight / App Store Beta"}},"ja":{"stringUnit":{"state":"translated","value":"TestFlight / App Store ベータ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"TestFlight / 商店测试版"}}}},
    "release.channel.appStoreBetaDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Updates are managed by TestFlight or the App Store. CLI, Selection Helper, ActionBroker, and external plugins are not included."}},"ja":{"stringUnit":{"state":"translated","value":"更新は TestFlight または App Store が管理します。CLI、選択ヘルパー、ActionBroker、外部プラグインは含まれません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更新由 TestFlight 或 App Store 管理；不包含 CLI、划词 Helper、ActionBroker 和外部插件。"}}}},
    "release.channel.development": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Development"}},"ja":{"stringUnit":{"state":"translated","value":"開発版"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开发版"}}}},
    "release.channel.developmentDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local development build; not a distributable release artifact."}},"ja":{"stringUnit":{"state":"translated","value":"ローカル開発用ビルドで、配布用成果物ではありません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地开发构建，不是可分发的发布产物。"}}}},
    "release.channel.directBeta": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Direct Beta"}},"ja":{"stringUnit":{"state":"translated","value":"公式サイト ベータ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"官网 Beta"}}}},
    "release.channel.directBetaDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Full-capability website build. Beta 1 and Beta 2 use manual updates."}},"ja":{"stringUnit":{"state":"translated","value":"全機能を含む公式サイト版です。Beta 1 と Beta 2 は手動更新です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保留完整能力的官网版本；Beta 1 和 Beta 2 使用手动更新。"}}}},
    "release.channel.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Distribution Channel"}},"ja":{"stringUnit":{"state":"translated","value":"配布チャネル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发布渠道"}}}},
    "release.section.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Release"}},"ja":{"stringUnit":{"state":"translated","value":"リリース"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"版本发布"}}}},
    "release.storeCapability.externalPlugins": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This channel only runs fixed built-in plugins shipped inside the reviewed app. Install and import entry points for external .blocksplugin packages are disabled at build time."}},"ja":{"stringUnit":{"state":"translated","value":"このチャネルでは審査済みアプリに同梱された固定の内蔵プラグインのみ実行します。外部 .blocksplugin のインストールと読み込みはビルド時に無効化されています。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此渠道只运行审核包内固定的内置插件；外部 .blocksplugin 的安装和导入入口已在构建期关闭。"}}}},
    "release.storeCapability.selectionHelper": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selection Helper pairing and download are available in the full website edition, not in this App Store-compatible build."}},"ja":{"stringUnit":{"state":"translated","value":"選択ヘルパーのペアリングとダウンロードは公式サイト完全版で利用でき、この App Store 対応版には含まれません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"划词 Helper 的下载和配对仅在官网完整版提供，不包含在此商店兼容版本中。"}}}},
    "release.storeCapability.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Website Edition Capability"}},"ja":{"stringUnit":{"state":"translated","value":"公式サイト版の機能"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"官网完整版能力"}}}},
    "release.update.check": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check for Updates"}},"ja":{"stringUnit":{"state":"translated","value":"アップデートを確認"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查更新"}}}},
    "release.update.manualDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens the official download page. This beta does not replace the app automatically."}},"ja":{"stringUnit":{"state":"translated","value":"公式ダウンロードページを開きます。このベータ版はアプリを自動で置き換えません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开官方下载页；当前 Beta 不会自动替换应用。"}}}},
    "release.update.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Updates"}},"ja":{"stringUnit":{"state":"translated","value":"アップデート"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更新"}}}},
    "release.update.urlPending": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The final download URL is intentionally disabled until the brand and domain are locked."}},"ja":{"stringUnit":{"state":"translated","value":"ブランドとドメインが確定するまで、最終ダウンロード URL は意図的に無効です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最终品牌和域名锁定前，下载地址按阶段门禁保持禁用。"}}}},
    "release.version.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Version"}},"ja":{"stringUnit":{"state":"translated","value":"バージョン"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"版本"}}}},
    "plugin.center.whatItDoes.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What It Does"}},"ja":{"stringUnit":{"state":"translated","value":"できること"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"功能说明"}}}},
    "plugin.center.whatItDoes.purpose": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What it helps with"}},"ja":{"stringUnit":{"state":"translated","value":"役立つこと"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"能帮你做什么"}}}},
    "plugin.center.whatItDoes.when": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"When it works"}},"ja":{"stringUnit":{"state":"translated","value":"動作するタイミング"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"什么时候生效"}}}},
    "plugin.center.whatItDoes.examples": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Examples"}},"ja":{"stringUnit":{"state":"translated","value":"例"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用示例"}}}},
