    "clipboard.sidecarCleanup.pending.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The records have already been deleted. %lld image attachments are pending cleanup and will be retried at the next launch or during later cleanup." } },
        "ja": { "stringUnit": { "state": "translated", "value": "記録はすでに削除されました。%lld 件の画像添付は削除待ちで、次回起動時または後続のクリーンアップ時に再試行されます。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "记录已经删除，%lld 个图片附件待清理，将在下次启动或后续清理时重试。" } }
