    "plugin.center.settings.rules": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Active Rules"}},"ja":{"stringUnit":{"state":"translated","value":"現在のルール"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前生效规则"}}}},
    "plugin.center.settings.rules.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose what this plugin should do when it runs."}},"ja":{"stringUnit":{"state":"translated","value":"プラグイン実行時の動作を選択します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"调整插件运行时会执行的规则。"}}}},
    "plugin.center.management.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plugin Management"}},"ja":{"stringUnit":{"state":"translated","value":"プラグイン管理"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件管理"}}}},
    "plugin.center.delete.row.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uninstall Plugin"}},"ja":{"stringUnit":{"state":"translated","value":"プラグインをアンインストール"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"卸载插件"}}}},
    "plugin.center.delete.row.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove this plugin and its local settings. Built-in plugins can be installed again later."}},"ja":{"stringUnit":{"state":"translated","value":"このプラグインとローカル設定を削除します。内蔵プラグインは後で再インストールできます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除此插件及其本地设置；内置插件以后仍可重新安装。"}}}},
    "plugin.center.controls.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plugin Controls"}},"ja":{"stringUnit":{"state":"translated","value":"プラグイン操作"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"功能操作"}}}},
    "plugin.center.activity.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recent Activity"}},"ja":{"stringUnit":{"state":"translated","value":"最近の動作"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最近运行"}}}},
    "plugin.center.activity.running": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Running"}},"ja":{"stringUnit":{"state":"translated","value":"実行中"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在运行"}}}},
    "plugin.center.activity.succeeded": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Last run completed"}},"ja":{"stringUnit":{"state":"translated","value":"前回の実行は完了しました"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上次运行成功"}}}},
    "plugin.center.activity.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Last run needs attention"}},"ja":{"stringUnit":{"state":"translated","value":"前回の実行を確認してください"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上次运行需要处理"}}}},
