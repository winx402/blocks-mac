    "settings.providerUserSecretDelete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove credential"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報を削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除凭据"
          }
        }
      }
    },
    "settings.providerUserSecretDeleteConfirmationDetail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This permanently removes the credential named \"%@\" from macOS Keychain. This cannot be undone. The secret itself is never shown." } },
        "ja": { "stringUnit": { "state": "translated", "value": "macOS キーチェーンから「%@」という認証情報を完全に削除します。この操作は取り消せません。シークレット自体は表示されません。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "将从 macOS 钥匙串永久移除名为“%@”的凭据。此操作不可撤销，且不会显示密钥内容。" } }
      }
    },
    "settings.providerUserSecretDeleteConfirmationTitle": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Remove credential permanently?" } },
        "ja": { "stringUnit": { "state": "translated", "value": "認証情報を完全に削除しますか？" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "永久移除凭据？" } }
      }
    },
    "settings.providerCancelledAliasMigration.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Cancelled save may have left a credential" } },
        "ja": { "stringUnit": { "state": "translated", "value": "キャンセルした保存で認証情報が残っている可能性があります" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已取消的保存可能仍保留凭据" } }
      }
    },
    "settings.providerCancelledAliasMigration.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Saving was cancelled. An inactive credential may remain under alias \"%@\". It will never be used for network requests; you can remove it." } },
        "ja": { "stringUnit": { "state": "translated", "value": "保存はキャンセルされました。別名「%@」に未有効の認証情報が残っている可能性があります。ネットワークリクエストには使用されません。削除できます。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "保存已取消。别名“%@”下可能仍有未启用凭据，绝不会用于网络；可移除。" } }
      }
    },
    "settings.providerCancelledAliasMigrationMalformed.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Credential recovery needs attention" } },
        "ja": { "stringUnit": { "state": "translated", "value": "認証情報の復旧に対応が必要です" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "凭据恢复需要处理" } }
      }
    },
    "settings.providerCancelledAliasMigrationMalformed.detail": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The cancelled-save recovery record is invalid. Credential actions and network use remain blocked to protect your data." } },
        "ja": { "stringUnit": { "state": "translated", "value": "キャンセルした保存の復旧記録が無効です。データを保護するため、認証情報の操作とネットワーク利用はブロックされたままです。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已取消保存的恢复记录无效。为保护数据，凭据操作和网络使用仍被阻断。" } }
      }
    },
