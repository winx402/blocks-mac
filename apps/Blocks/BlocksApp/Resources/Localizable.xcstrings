    "settings.providerUserSecretGateNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "P5-K only writes the confirmed key to Keychain and shows account, existence, length, and audit ID; it never reads the key value, hashes it, or sends a network request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "P5-K は確認済み key を Keychain に書き込み、account、存在状態、長さ、audit ID だけを表示します。key 原文の読み取り、hash 計算、network request は行いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "P5-K 只把用户确认的 key 写入 Keychain，并只显示 account、存在性、长度和审计 ID；不会读取 key 原文、不会计算 key hash、不会发起网络请求。"
          }
        }
      }
    },
