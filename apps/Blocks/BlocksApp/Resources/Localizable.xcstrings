    "settings.shortcutReregisterFailedDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed: %@. Global registration itself needs no accessibility permission. Change the conflicting key; screenshot and automatic paste actions may separately require Screen Recording or Accessibility permission."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗: %@。グローバル登録自体にアクセシビリティ権限は不要です。競合するキーを変更してください。スクリーンショットや自動ペーストには別途、画面収録またはアクセシビリティ権限が必要な場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败：%@。全局快捷键注册本身不需要辅助功能权限，请先修改冲突组合；截图和自动粘贴动作可能另外需要屏幕录制或辅助功能权限。"
          }
        }
      }
    },
