    "settings.providerConnectionFailed.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to connect"}},"ja":{"stringUnit":{"state":"translated","value":"接続できませんでした"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法连接"}}}},
    "settings.providerExternalTransferRevocationFailed.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"External requests are blocked in this session, but Blocks could not confirm that the change was saved."}},"ja":{"stringUnit":{"state":"translated","value":"このセッションでは外部リクエストをブロックしましたが、変更が保存されたことを確認できませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本次运行已阻止外部请求，但“积木”无法确认撤权设置已成功保存。"}}}},
    "settings.providerExternalTransferRevocationFailed.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"External transfer remains blocked"}},"ja":{"stringUnit":{"state":"translated","value":"外部転送は引き続きブロックされています"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"外部传输仍已阻止"}}}},
    "settings.providerConnectionFailure.address": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The service address is invalid. Check it and try again."}},"ja":{"stringUnit":{"state":"translated","value":"サービスアドレスが正しくありません。確認してもう一度お試しください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务地址无效，请检查后重试。"}}}},
    "settings.providerConnectionFailure.capability": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This service does not support the configured model or connection method."}},"ja":{"stringUnit":{"state":"translated","value":"このサービスは設定したモデルまたは接続方法に対応していません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此服务不支持当前模型或连接方式。"}}}},
    "settings.providerConnectionFailure.confirmation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm the external connection, then try again."}},"ja":{"stringUnit":{"state":"translated","value":"外部接続を確認してから、もう一度お試しください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先确认允许外部连接，然后重试。"}}}},
    "settings.providerConnectionFailure.credential": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The credential was rejected or is missing. Save a valid API key and try again."}},"ja":{"stringUnit":{"state":"translated","value":"認証情報がないか、拒否されました。有効な API キーを保存して再試行してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"凭据缺失或被拒绝，请保存有效的 API Key 后重试。"}}}},
    "settings.providerConnectionFailure.network": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The service could not be reached. Check the network and try again."}},"ja":{"stringUnit":{"state":"translated","value":"サービスに接続できません。ネットワークを確認して再試行してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法访问服务，请检查网络后重试。"}}}},
    "settings.providerConnectionFailure.rateLimit": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The service is rate-limited. Wait a moment and try again."}},"ja":{"stringUnit":{"state":"translated","value":"利用制限に達しました。しばらく待ってから再試行してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务触发了频率限制，请稍后重试。"}}}},
    "settings.providerConnectionFailure.service": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The service returned an unexpected response. Try again later or check its status."}},"ja":{"stringUnit":{"state":"translated","value":"サービスから予期しない応答が返されました。後でもう一度お試しください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务返回了异常响应，请稍后重试或检查服务状态。"}}}},
