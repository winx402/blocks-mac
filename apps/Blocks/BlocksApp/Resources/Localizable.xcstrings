    "status.clipboardPasteRetry.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility is now available, but the original target is no longer ready. The item remains copied; press Command+V manually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティは利用可能になりましたが、元の対象は貼り付け可能な状態ではありません。項目はコピー済みです。Command+V で手動で貼り付けてください。"
          }
        },
