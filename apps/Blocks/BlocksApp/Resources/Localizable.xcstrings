    "settings.shortcutReregisterAcceptedDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS accepted %d shortcuts; %d are disabled. Trigger each shortcut once in another app to verify delivery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が %d 件のショートカットを受理し、%d 件は無効です。別の App で各ショートカットを一度実行し、配信を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已接受 %d 个快捷键，%d 个已禁用。请在其他 App 中分别触发一次，确认事件确实送达。"
          }
        }
      }
    },
