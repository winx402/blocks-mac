    "settings.agentCLI.actionBroker.connecting": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Registered. Connecting Blocks…"}},"ja":{"stringUnit":{"state":"translated","value":"登録済みです。Blocks に接続しています…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务已登记，正在连接 Blocks…"}}}},
    "settings.agentCLI.actionBroker.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Lets verified local tools request supported Blocks actions."}},"ja":{"stringUnit":{"state":"translated","value":"検証済みのローカルツールが対応する Blocks の操作を要求できるようにします。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"允许经过验证的本地工具请求 Blocks 支持的操作。"}}}},
    "settings.agentCLI.actionBroker.disabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not registered."}},"ja":{"stringUnit":{"state":"translated","value":"登録されていません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未登记。"}}}},
    "settings.agentCLI.actionBroker.enable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable Action Broker"}},"ja":{"stringUnit":{"state":"translated","value":"アクションブローカーを有効にする"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用动作代理服务"}}}},
    "settings.agentCLI.actionBroker.enabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Registered and ready."}},"ja":{"stringUnit":{"state":"translated","value":"登録済みで、利用できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务已登记并可用。"}}}},
