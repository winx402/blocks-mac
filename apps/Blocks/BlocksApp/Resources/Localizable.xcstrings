    "settings.agentCLI.install.changed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The command at %@ has changed. Blocks will not replace or remove it."}},"ja":{"stringUnit":{"state":"translated","value":"%@ のコマンドは変更されています。Blocks は置換も削除もしません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 处的命令已被更改。Blocks 不会替换或删除它。"}}}},
    "settings.agentCLI.install.current": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The command at %@ matches this version. No shell profile is modified."}},"ja":{"stringUnit":{"state":"translated","value":"%@ のコマンドはこのバージョンと一致します。シェル設定は変更しません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 处的命令与当前版本一致；不会修改 Shell 配置。"}}}},
    "settings.agentCLI.install.destinationConflict": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A command already exists there and is not managed by Blocks. Choose another location."}},"ja":{"stringUnit":{"state":"translated","value":"その場所には Blocks が管理していないコマンドが既にあります。別の場所を選択してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该位置已有一个不受 Blocks 管理的命令。请选择其他位置。"}}}},
    "settings.agentCLI.install.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install the signed blocks command to a directory already on PATH, such as ~/.local/bin."}},"ja":{"stringUnit":{"state":"translated","value":"署名済み blocks コマンドを ~/.local/bin など PATH 上のディレクトリへインストールします。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将已签名的 blocks 命令安装到 PATH 已包含的目录，例如 ~/.local/bin。"}}}},
    "settings.agentCLI.install.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Installation failed. Choose a writable directory and try again."}},"ja":{"stringUnit":{"state":"translated","value":"インストールに失敗しました。書き込み可能な場所を選んでもう一度お試しください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装失败，请选择可写目录后重试。"}}}},
    "settings.agentCLI.recovery.required": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Automatic recovery stopped. Blocks did not overwrite an unknown file. A recovery file or command needs inspection; check it in Finder before continuing."}},"ja":{"stringUnit":{"state":"translated","value":"自動復旧を停止しました。Blocks は不明なファイルを上書きしていません。復旧ファイルまたはコマンドを確認する必要があります。続行する前に Finder で確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动恢复已停止。Blocks 没有覆盖未知文件。存在需要检查的恢复文件或命令；请先在 Finder 中检查，再继续。"}}}},
    "settings.agentCLI.recovery.reveal": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review Recovery in Finder"}},"ja":{"stringUnit":{"state":"translated","value":"Finder で復旧項目を確認"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Finder 中检查恢复项"}}}},
    "settings.agentCLI.recovery.revealHelp": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Shows the recovery file or command that needs review before any further action."}},"ja":{"stringUnit":{"state":"translated","value":"次の操作前に確認が必要な復旧ファイルまたはコマンドを表示します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"显示在继续操作前需要检查的恢复文件或命令。"}}}},
    "settings.agentCLI.install.installed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Installed"}},"ja":{"stringUnit":{"state":"translated","value":"インストール済み"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安装"}}}},
    "settings.agentCLI.install.installing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Installing…"}},"ja":{"stringUnit":{"state":"translated","value":"インストール中…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在安装…"}}}},
    "settings.agentCLI.install.inaccessible": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Blocks can no longer access the managed command. It will not be changed or removed."}},"ja":{"stringUnit":{"state":"translated","value":"Blocks は管理対象コマンドにアクセスできなくなりました。変更も削除も行いません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Blocks 无法再访问受管理的命令，因此不会更改或删除它。"}}}},
    "settings.agentCLI.install.missing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The managed command is missing from %@. Choose a location to install again."}},"ja":{"stringUnit":{"state":"translated","value":"管理対象コマンドが %@ から見つかりません。場所を選んで再インストールしてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"受管理的命令已从 %@ 消失。请选择位置重新安装。"}}}},
    "settings.agentCLI.install.outdated": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"An older or different blocks command is installed. Reinstall to update it."}},"ja":{"stringUnit":{"state":"translated","value":"古い、または別の blocks コマンドがインストールされています。再インストールして更新してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安装的 blocks 命令版本不同，请重新安装更新。"}}}},
    "settings.agentCLI.install.panelTitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install Blocks Command Line Tool"}},"ja":{"stringUnit":{"state":"translated","value":"Blocks コマンドラインツールをインストール"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装 Blocks 命令行工具"}}}},
    "settings.agentCLI.install.reinstall": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reinstall…"}},"ja":{"stringUnit":{"state":"translated","value":"再インストール…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新安装…"}}}},
    "settings.agentCLI.install.refresh": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check Again"}},"ja":{"stringUnit":{"state":"translated","value":"再確認"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新检查"}}}},
    "settings.agentCLI.install.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Blocks Command"}},"ja":{"stringUnit":{"state":"translated","value":"Blocks コマンド"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Blocks 命令"}}}},
    "settings.agentCLI.install.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This build does not include the command line tool."}},"ja":{"stringUnit":{"state":"translated","value":"このビルドにはコマンドラインツールが含まれていません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前构建未包含命令行工具。"}}}},
    "settings.agentCLI.install.update": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Update…"}},"ja":{"stringUnit":{"state":"translated","value":"アップデート…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更新…"}}}},
    "settings.agentCLI.install.updateAvailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"An update is available for the managed command at %@."}},"ja":{"stringUnit":{"state":"translated","value":"%@ の管理対象コマンドにアップデートがあります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 处受管理的命令有可用更新。"}}}},
    "settings.agentCLI.uninstall.button": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uninstall"}},"ja":{"stringUnit":{"state":"translated","value":"アンインストール"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安全卸载"}}}},
    "settings.agentCLI.uninstall.confirm": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove Command"}},"ja":{"stringUnit":{"state":"translated","value":"コマンドを削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除命令"}}}},
    "settings.agentCLI.uninstall.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only this managed blocks command will be removed. PATH and shell profiles are not changed."}},"ja":{"stringUnit":{"state":"translated","value":"この管理対象 blocks コマンドだけを削除します。PATH とシェル設定は変更しません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅删除这个受管理的 blocks 命令；不会修改 PATH 或 Shell 配置。"}}}},
    "settings.agentCLI.uninstall.removing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Removing the managed command…"}},"ja":{"stringUnit":{"state":"translated","value":"管理対象のコマンドを削除しています…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在删除受管理的命令…"}}}},
    "settings.agentCLI.uninstall.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove Blocks Command?"}},"ja":{"stringUnit":{"state":"translated","value":"Blocks コマンドを削除しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除 Blocks 命令？"}}}},
