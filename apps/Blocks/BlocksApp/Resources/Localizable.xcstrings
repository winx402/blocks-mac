    "settings.glassDiagnostics.materialNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pass reduces heavy card materials without faking the system effect using custom high-transparency backgrounds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この更新では重いカード素材を減らしますが、独自の高透明背景でシステム効果を偽装しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮会减少厚重卡片材质，但不会用自绘高透明背景伪造系统效果。"
          }
        }
      }
    },
    "settings.glassDiagnostics.reduceOff": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not reduced"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低減なし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未降低透明度"
          }
        }
      }
    },
    "settings.glassDiagnostics.reduceOffDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Transparency was not detected; if glass still looks subtle, it usually depends on wallpaper, content behind the window, and system glass behavior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明度を下げる設定は検出されませんでした。見え方が控えめな場合は、壁紙、背後の内容、システムのガラス表現に左右されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到降低透明度设置；如果仍然不明显，通常与桌面背景、窗口后方内容和系统玻璃策略有关。"
          }
        }
      }
    },
    "settings.glassDiagnostics.reduceOn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduced"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低減中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已降低透明度"
          }
        }
      }
    },
    "settings.glassDiagnostics.reduceOnDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Reduce Transparency is enabled, so glass and translucent materials are muted by the system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS の透明度を下げる設定が有効なため、ガラスと半透明素材は控えめに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 当前启用了降低透明度，系统会弱化毛玻璃和透明材质。"
          }
        }
      }
    },
    "settings.glassDiagnostics.system": {
      "localizations": {
        "en": {
