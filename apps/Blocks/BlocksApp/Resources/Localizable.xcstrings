    "settings.agentCLI.actionBroker.reconnecting": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection interrupted. Reconnecting…"}},"ja":{"stringUnit":{"state":"translated","value":"接続が中断されました。再接続しています…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接已中断，正在重连…"}}}},
    "settings.agentCLI.actionBroker.recovering": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Still unavailable. Blocks will keep checking periodically."}},"ja":{"stringUnit":{"state":"translated","value":"まだ利用できません。Blocks が定期的に確認を続けます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仍不可用，Blocks 会定期继续检查。"}}}},
    "settings.agentCLI.actionBroker.requiresApproval": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Requires approval in System Settings."}},"ja":{"stringUnit":{"state":"translated","value":"システム設定での承認が必要です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要在系统设置中批准。"}}}},
    "settings.agentCLI.actionBroker.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This build does not include Action Broker."}},"ja":{"stringUnit":{"state":"translated","value":"このビルドにはアクションブローカーが含まれていません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前构建未包含动作代理服务。"}}}},
