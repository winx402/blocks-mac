    "settings.permissionActionSigningOrIdentityMismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current app signing or path identity is unstable. Use stable signing and a fixed app path, then authorize again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の App の署名またはパス識別が不安定です。安定した署名と固定 App パスで再度許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 App 签名或路径身份不稳定；请使用稳定签名与固定 App 路径后重新授权。"
          }
        }
      }
    },
