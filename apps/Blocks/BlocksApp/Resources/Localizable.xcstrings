      }
    },
    "plugin.runtime.destructiveConfirmation.message": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%1$@ wants to permanently delete “%2$@”. This action cannot be undone." } },
        "ja": { "stringUnit": { "state": "translated", "value": "%1$@ が「%2$@」を完全に削除しようとしています。この操作は取り消せません。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "%1$@ 想要永久删除“%2$@”。此操作无法撤销。" } }
