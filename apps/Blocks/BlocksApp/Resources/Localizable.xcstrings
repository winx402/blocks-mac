    "plugin.center.activity.notRun.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The latest result will appear here after the plugin first runs."}},"ja":{"stringUnit":{"state":"translated","value":"初回実行後、ここに最新結果が表示されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件首次生效后，这里会显示最近结果。"}}}},
    "plugin.center.activity.resume": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Resume"}},"ja":{"stringUnit":{"state":"translated","value":"再開"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复运行"}}}},
    "plugin.center.data.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Data and Privacy"}},"ja":{"stringUnit":{"state":"translated","value":"データとプライバシー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据与隐私"}}}},
    "plugin.center.data.access": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Data it uses"}},"ja":{"stringUnit":{"state":"translated","value":"使用するデータ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"会使用的数据"}}}},
    "plugin.center.presentation.summary.fallback": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Extends Blocks with an installed capability."}},"ja":{"stringUnit":{"state":"translated","value":"Blocks に機能を追加します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为 Blocks 增加一项扩展能力。"}}}},
    "plugin.center.presentation.purpose.fallback": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This plugin adds an optional workflow to Blocks."}},"ja":{"stringUnit":{"state":"translated","value":"Blocks に任意のワークフローを追加します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此插件为 Blocks 增加可选的工作流程。"}}}},
    "plugin.center.presentation.trigger.fallback": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"It works when its related Blocks feature is used."}},"ja":{"stringUnit":{"state":"translated","value":"関連する Blocks 機能を使用したときに動作します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用对应的 Blocks 功能时生效。"}}}},
    "plugin.center.presentation.data.fallback": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uses only the data you approve during installation."}},"ja":{"stringUnit":{"state":"translated","value":"インストール時に許可したデータのみ使用します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅使用安装时由你确认授权的数据。"}}}},
    "plugin.center.review.data.appContext": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Current app context"}},"ja":{"stringUnit":{"state":"translated","value":"現在のアプリの状況"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前应用状态"}}}},
    "plugin.center.review.data.clipboardContent": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clipboard contents"}},"ja":{"stringUnit":{"state":"translated","value":"クリップボードの内容"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"剪贴板内容"}}}},
    "plugin.center.review.data.other": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Other data or operation permissions"}},"ja":{"stringUnit":{"state":"translated","value":"その他のデータまたは操作の許可"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"其他数据或操作权限"}}}},
    "plugin.center.review.data.providerMetadata": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Provider settings"}},"ja":{"stringUnit":{"state":"translated","value":"プロバイダ設定"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务提供方设置"}}}},
    "plugin.center.review.data.screenshotDocument": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Screenshot documents"}},"ja":{"stringUnit":{"state":"translated","value":"スクリーンショット書類"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"截图文稿"}}}},
    "plugin.center.review.data.screenshotImage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Screenshot images"}},"ja":{"stringUnit":{"state":"translated","value":"スクリーンショット画像"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"截图图像"}}}},
    "plugin.center.review.data.translationContent": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Text sent for translation"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳に送るテキスト"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"用于翻译的文本"}}}},
    "plugin.center.review.data.userGrantedFiles": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Files you choose to grant"}},"ja":{"stringUnit":{"state":"translated","value":"あなたが許可するファイル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你明确授权的文件"}}}},
    "plugin.center.review.failClosed.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"If this plugin's automatic check fails, Blocks stops the affected original workflow instead of continuing it."}},"ja":{"stringUnit":{"state":"translated","value":"このプラグインの自動確認に失敗すると、Blocks は影響を受ける元のワークフローを続行せず停止します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如果此插件的自动检查失败，Blocks 会停止受影响的原工作流程，而不会继续执行。"}}}},
    "plugin.center.review.failurePolicy.failClosed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Failure blocks the original workflow"}},"ja":{"stringUnit":{"state":"translated","value":"失敗すると元のワークフローを停止"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"失败会阻止原工作流程"}}}},
    "plugin.center.review.failurePolicy.failOpen": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Failure lets the original workflow continue"}},"ja":{"stringUnit":{"state":"translated","value":"失敗しても元のワークフローを続行"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"失败后原工作流程仍继续"}}}},
    "plugin.center.review.background.foreground": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runs before this Blocks workflow continues"}},"ja":{"stringUnit":{"state":"translated","value":"この Blocks ワークフローが続行する前に実行"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在此 Blocks 工作流程继续前运行"}}}},
    "plugin.center.review.background.runs": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Can run in the background"}},"ja":{"stringUnit":{"state":"translated","value":"バックグラウンドで実行可能"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可在后台运行"}}}},
    "plugin.center.review.hooks.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Can run automatically when a Blocks workflow reaches an approved point."}},"ja":{"stringUnit":{"state":"translated","value":"Blocks のワークフローが許可済みの時点に達すると自動実行できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当 Blocks 工作流程到达已授权的节点时，可以自动运行。"}}}},
    "plugin.center.review.hooks.module.app": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App lifecycle"}},"ja":{"stringUnit":{"state":"translated","value":"アプリのライフサイクル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用生命周期"}}}},
    "plugin.center.review.hooks.module.automation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Automation"}},"ja":{"stringUnit":{"state":"translated","value":"自動化"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动化"}}}},
    "plugin.center.review.hooks.module.clipboard": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clipboard"}},"ja":{"stringUnit":{"state":"translated","value":"クリップボード"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"剪贴板"}}}},
    "plugin.center.review.hooks.module.count": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%1$@ workflows (%2$lld)"}},"ja":{"stringUnit":{"state":"translated","value":"%1$@ の自動処理（%2$lld 件）"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%1$@ 工作流程（%2$lld 项）"}}}},
    "plugin.center.review.hooks.module.plugin": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plugin lifecycle"}},"ja":{"stringUnit":{"state":"translated","value":"プラグインのライフサイクル"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件生命周期"}}}},
    "plugin.center.review.hooks.module.provider": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Online service"}},"ja":{"stringUnit":{"state":"translated","value":"オンラインサービス"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在线服务"}}}},
    "plugin.center.review.hooks.module.screenshot": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Screenshot"}},"ja":{"stringUnit":{"state":"translated","value":"スクリーンショット"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"截图"}}}},
    "plugin.center.review.hooks.module.translation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译"}}}},
    "plugin.center.review.hostActions.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Can ask Blocks to perform approved actions (%lld)."}},"ja":{"stringUnit":{"state":"translated","value":"Blocks に許可済みの操作を依頼できます（%lld 件）。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以请求 Blocks 执行已授权操作（%lld 项）。"}}}},
    "plugin.center.review.hostAction.clipboard.copyText": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy text to the system clipboard"}},"ja":{"stringUnit":{"state":"translated","value":"テキストをシステムのクリップボードへコピー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将文字复制到系统剪贴板"}}}},
    "plugin.center.review.hostAction.clipboard.pasteRecord": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paste a clipboard record into the active app"}},"ja":{"stringUnit":{"state":"translated","value":"クリップボード履歴を現在のアプリへペースト"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将剪贴板记录粘贴到当前 App"}}}},
    "plugin.center.review.hostAction.clipboard.bringToFront": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Move a clipboard record to the front"}},"ja":{"stringUnit":{"state":"translated","value":"クリップボード履歴を先頭へ移動"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将剪贴板记录置顶"}}}},
    "plugin.center.review.hostAction.clipboard.deleteRecord": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete clipboard records"}},"ja":{"stringUnit":{"state":"translated","value":"クリップボード履歴を削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除剪贴板记录"}}}},
    "plugin.center.review.hostAction.clipboard.favoriteRecord": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Change whether clipboard records are favorited"}},"ja":{"stringUnit":{"state":"translated","value":"クリップボード履歴のお気に入り状態を変更"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改剪贴板记录的收藏状态"}}}},
    "plugin.center.review.hostAction.clipboard.ocrRecord": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recognize text in clipboard images"}},"ja":{"stringUnit":{"state":"translated","value":"クリップボード画像の文字を認識"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"识别剪贴板图片中的文字"}}}},
    "plugin.center.review.hostAction.clipboard.readRecord": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Read clipboard record content and metadata"}},"ja":{"stringUnit":{"state":"translated","value":"クリップボード履歴の内容と情報を読み取り"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"读取剪贴板记录内容和信息"}}}},
