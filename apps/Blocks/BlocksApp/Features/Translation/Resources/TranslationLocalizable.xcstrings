    "translation.service.availability.requires_download" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Language download required"}},"ja":{"stringUnit":{"state":"translated","value":"言語のダウンロードが必要"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要下载语言包"}}}},
