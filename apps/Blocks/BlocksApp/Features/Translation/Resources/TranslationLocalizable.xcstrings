    "translation.plugin.secret.checking" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking credential status"}},"ja":{"stringUnit":{"state":"translated","value":"認証情報の状態を確認中"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查凭据状态"}}}},
    "translation.plugin.secret.configured" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Stored securely in Keychain"}},"ja":{"stringUnit":{"state":"translated","value":"キーチェーンに安全に保存済み"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安全存储在钥匙串"}}}},
    "translation.plugin.secret.delete" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete credential"}},"ja":{"stringUnit":{"state":"translated","value":"認証情報を削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除凭据"}}}},
    "translation.plugin.secret.deleteConfirmation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete this plugin credential?"}},"ja":{"stringUnit":{"state":"translated","value":"このプラグインの認証情報を削除しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除这项插件凭据？"}}}},
    "translation.plugin.secret.deleteConfirmationDetail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ will no longer be able to use “%@” until you enter it again."}},"ja":{"stringUnit":{"state":"translated","value":"再入力するまで、%@ は「%@」を使用できなくなります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除后，%@ 将无法使用“%@”，直到你重新录入。"}}}},
    "translation.plugin.secret.deleted" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credential deleted"}},"ja":{"stringUnit":{"state":"translated","value":"認証情報を削除しました"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"凭据已删除"}}}},
    "translation.plugin.secret.deletedRequiresValidation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credential deleted. The plugin is disabled and must pass another connection test before use."}},"ja":{"stringUnit":{"state":"translated","value":"認証情報を削除しました。プラグインは無効化され、再利用前に接続テストが必要です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"凭据已删除；插件已停用，重新使用前需再次通过连接测试。"}}}},
