    "translation.plugin.permissionManifestInvalid" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Permission manifest unavailable"}},"ja":{"stringUnit":{"state":"translated","value":"権限マニフェストを読み取れません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取权限清单"}}}},
    "translation.plugin.permissionManifestInvalid.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Blocks will not infer missing permissions. Reinstall or remove this plugin before using it again."}},"ja":{"stringUnit":{"state":"translated","value":"Blocks は不足している権限を推測しません。このプラグインを再利用する前に、再インストールまたは削除してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Blocks 不会推断缺失的权限。请重新安装或移除该插件后再使用。"}}}},
