    "translation.community.connectionTestFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Community source connection failed"}},"ja":{"stringUnit":{"state":"translated","value":"コミュニティ翻訳ソースに接続できませんでした"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"社区翻译源连接失败"}}}},
    "translation.community.connectionTestSucceeded" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The community source returned a valid translation."}},"ja":{"stringUnit":{"state":"translated","value":"コミュニティ翻訳ソースから有効な翻訳が返されました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"社区翻译源已返回有效译文。"}}}},
    "translation.community.connectionTestSucceededTitle" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection succeeded"}},"ja":{"stringUnit":{"state":"translated","value":"接続に成功しました"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接成功"}}}},
    "translation.community.error.emptyResponse" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The community source returned no translation."}},"ja":{"stringUnit":{"state":"translated","value":"コミュニティソースから翻訳結果が返されませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"社区翻译源没有返回译文。"}}}},
    "translation.community.error.httpStatus" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The community source returned HTTP %lld."}},"ja":{"stringUnit":{"state":"translated","value":"コミュニティソースが HTTP %lld を返しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"社区翻译源返回 HTTP %lld。"}}}},
    "translation.community.error.inputTooLarge" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The text is too long for this community source."}},"ja":{"stringUnit":{"state":"translated","value":"このコミュニティソースには原文が長すぎます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原文超过该社区翻译源的长度限制。"}}}},
    "translation.community.error.invalidRequest" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The community source request did not pass the network safety policy."}},"ja":{"stringUnit":{"state":"translated","value":"コミュニティソースへのリクエストがネットワーク安全ポリシーを満たしていません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"社区翻译源请求未通过网络安全策略。"}}}},
    "translation.community.error.invalidResponse" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The community source returned an unsupported response."}},"ja":{"stringUnit":{"state":"translated","value":"コミュニティソースから未対応の応答が返されました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"社区翻译源返回了无法解析的响应。"}}}},
    "translation.community.error.network" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The community source could not be reached."}},"ja":{"stringUnit":{"state":"translated","value":"コミュニティソースに接続できませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法连接社区翻译源。"}}}},
    "translation.community.error.responseLanguageMismatch" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The translation source returned the wrong target language."}},"ja":{"stringUnit":{"state":"translated","value":"翻訳ソースが指定と異なる言語を返しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译源返回了错误的目标语种。"}}}},
    "translation.community.service.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No API credential required · Non-official · May be rate-limited or stop working"}},"ja":{"stringUnit":{"state":"translated","value":"API認証情報不要・非公式・制限または停止の可能性あり"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"免 API 配置 · 非官方 · 可能限流或失效"}}}},
