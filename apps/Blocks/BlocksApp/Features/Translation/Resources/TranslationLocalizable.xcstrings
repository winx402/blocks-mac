    "translation.plugin.enabledCount" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ enabled"}},"ja":{"stringUnit":{"state":"translated","value":"%@件を有効化"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已启用 %@ 个"}}}},
    "translation.plugin.emptyDetail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install a .blocksplugin package to add translation or OCR services."}},"ja":{"stringUnit":{"state":"translated","value":".blockspluginパッケージをインストールして翻訳またはOCRサービスを追加できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装 .blocksplugin 包以添加翻译或 OCR 服务。"}}}},
    "translation.plugin.enabled" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plugin enabled"}},"ja":{"stringUnit":{"state":"translated","value":"プラグインを有効にしました"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件已启用"}}}},
    "translation.plugin.error.generic" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin operation could not be completed. Review the plugin and try again."}},"ja":{"stringUnit":{"state":"translated","value":"プラグイン操作を完了できませんでした。プラグインを確認して再試行してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法完成插件操作，请检查插件后重试。"}}}},
    "translation.plugin.error.invalidPackage" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected package is not a valid .blocksplugin package."}},"ja":{"stringUnit":{"state":"translated","value":"選択したパッケージは有効な.blockspluginパッケージではありません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选内容不是有效的 .blocksplugin 插件包。"}}}},
    "translation.plugin.error.missingSecret" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Configure the required secret “%@” before enabling this plugin."}},"ja":{"stringUnit":{"state":"translated","value":"このプラグインを有効にする前に、必須シークレット「%@」を設定してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用该插件前，请先配置必需凭据“%@”。"}}}},
    "translation.plugin.error.operationInProgress" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wait for the current plugin operation to finish, then try again."}},"ja":{"stringUnit":{"state":"translated","value":"現在のプラグイン操作が完了してから再試行してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请等待当前插件操作完成后再试。"}}}},
    "translation.plugin.error.reviewAgain" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The pending plugin package changed or expired. Review it again before installing."}},"ja":{"stringUnit":{"state":"translated","value":"保留中のプラグインパッケージが変更されたか期限切れです。インストール前に再確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"待安装插件已变化或失效，请重新复核后安装。"}}}},
    "translation.plugin.error.validationRequired" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Run a successful connection test for the current configuration before enabling this plugin."}},"ja":{"stringUnit":{"state":"translated","value":"このプラグインを有効にする前に、現在の設定で接続テストを成功させてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用该插件前，请先使用当前配置完成一次成功的连接测试。"}}}},
    "translation.plugin.error.secretStorage" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin credential could not be saved securely. Check Keychain access and try again."}},"ja":{"stringUnit":{"state":"translated","value":"プラグインの認証情報を安全に保存できませんでした。キーチェーンへのアクセスを確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法安全保存插件凭据，请检查钥匙串访问后重试。"}}}},
    "translation.plugin.error.storage" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Blocks could not safely update the installed plugin. The previous version was preserved when possible."}},"ja":{"stringUnit":{"state":"translated","value":"インストール済みプラグインを安全に更新できませんでした。可能な場合は以前のバージョンを保持しています。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法安全更新已安装插件；可恢复时已保留原版本。"}}}},
