    "translation.selection.permission.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allow Accessibility access for Blocks Selection Helper so it can read the current text selection."}},"ja":{"stringUnit":{"state":"translated","value":"現在の選択テキストを読み取るには Blocks Selection Helper のアクセシビリティアクセスを許可してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请允许“积木划词翻译助手”的辅助功能权限，以读取当前选中的文字。"}}}},
