    "translation.service.kind.community_web" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Community web source"}},"ja":{"stringUnit":{"state":"translated","value":"コミュニティWebソース"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"社区网页源"}}}},
    "translation.service.kind.official_external" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Official external service"}},"ja":{"stringUnit":{"state":"translated","value":"公式外部サービス"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"官方外部服务"}}}},
    "translation.service.kind.openai_compatible" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenAI-compatible"}},"ja":{"stringUnit":{"state":"translated","value":"OpenAI互換"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"OpenAI 兼容"}}}},
    "translation.service.kind.plugin" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plugin"}},"ja":{"stringUnit":{"state":"translated","value":"プラグイン"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件"}}}},
    "translation.services.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable up to four services. Results always stay in the configured order even when services finish at different times."}},"ja":{"stringUnit":{"state":"translated","value":"最大4サービスを有効にできます。完了順に関係なく、結果は設定した順序のまま表示されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最多启用四个服务；即使完成时间不同，结果也始终按配置顺序展示。"}}}},
    "translation.services.empty" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No translation services"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳サービスがありません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有翻译服务"}}}},
    "translation.services.emptyDetail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Configure an external service or install a translation plugin."}},"ja":{"stringUnit":{"state":"translated","value":"外部サービスを設定するか、翻訳プラグインをインストールしてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请配置外部服务或安装翻译插件。"}}}},
    "translation.services.enabledCount" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ of 4 services enabled"}},"ja":{"stringUnit":{"state":"translated","value":"4件中%@件を有効化"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已启用 %@ / 4 个服务"}}}},
    "translation.services.externalConfiguration" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenAI-compatible source"}},"ja":{"stringUnit":{"state":"translated","value":"OpenAI互換ソース"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"OpenAI 兼容翻译源"}}}},
    "translation.services.externalConfigurationDetail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only OpenAI-compatible endpoints, models, and API credentials are managed on the AI Services page. Add other official sources above."}},"ja":{"stringUnit":{"state":"translated","value":"AIサービスページでは OpenAI互換のエンドポイント、モデル、API認証情報のみを管理します。その他の公式サービスは上で追加してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AI 服务页仅管理 OpenAI 兼容端点、模型和 API 凭据；其他官方翻译源请在上方添加。"}}}},
    "translation.services.configureFirst" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Configure this source first"}},"ja":{"stringUnit":{"state":"translated","value":"先に設定してください"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先完成配置"}}}},
    "translation.services.maximumReached" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Disable another service before enabling this one"}},"ja":{"stringUnit":{"state":"translated","value":"このサービスを有効にする前に別のサービスを無効にしてください"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如需启用，请先停用其他服务"}}}},
    "translation.services.moveDown" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Move service down"}},"ja":{"stringUnit":{"state":"translated","value":"サービスを下へ移動"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下移服务"}}}},
    "translation.services.moveUp" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Move service up"}},"ja":{"stringUnit":{"state":"translated","value":"サービスを上へ移動"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上移服务"}}}},
    "translation.services.noneEnabledDetail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation is currently unavailable. Enable at least one service."}},"ja":{"stringUnit":{"state":"translated","value":"現在は翻訳できません。少なくとも1つのサービスを有効にしてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前无法翻译，请至少启用一个服务。"}}}},
    "translation.services.openProviderSettings" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open AI Services"}},"ja":{"stringUnit":{"state":"translated","value":"AIサービスを開く"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开 AI 服务"}}}},
    "translation.services.recipient.alibaba" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Alibaba Cloud"}},"ja":{"stringUnit":{"state":"translated","value":"Alibaba Cloud"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"阿里云"}}}},
    "translation.services.recipient.deepl" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"DeepL"}},"ja":{"stringUnit":{"state":"translated","value":"DeepL"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"DeepL"}}}},
    "translation.services.recipient.google" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Google Cloud"}},"ja":{"stringUnit":{"state":"translated","value":"Google Cloud"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Google Cloud"}}}},
    "translation.services.recipient.libre" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"the configured LibreTranslate server"}},"ja":{"stringUnit":{"state":"translated","value":"設定したLibreTranslateサーバー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已配置的 LibreTranslate 服务器"}}}},
    "translation.services.recipient.microsoft" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Microsoft Azure"}},"ja":{"stringUnit":{"state":"translated","value":"Microsoft Azure"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Microsoft Azure"}}}},
    "translation.services.rowDetail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ · %@ · Result order %@"}},"ja":{"stringUnit":{"state":"translated","value":"%@ · %@ · 結果順 %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ · %@ · 结果顺序 %@"}}}},
    "translation.services.resultOrder.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This order controls the translation result cards. It does not move sources in the catalog below."}},"ja":{"stringUnit":{"state":"translated","value":"この順序は翻訳結果カードに適用されます。下の翻訳ソース一覧の位置は変わりません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此顺序仅控制翻译结果卡，不会改变下方翻译源目录的位置。"}}}},
    "translation.services.resultOrder.dragHint" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Drag to reorder"}},"ja":{"stringUnit":{"state":"translated","value":"ドラッグして並べ替え"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"拖动排序"}}}},
    "translation.services.resultOrder.position" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Result position %@"}},"ja":{"stringUnit":{"state":"translated","value":"結果の順序 %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结果顺序 %@"}}}},
    "translation.services.resultOrder.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Result Order"}},"ja":{"stringUnit":{"state":"translated","value":"結果の順序"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结果顺序"}}}},
    "translation.services.template.alibaba" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Alibaba Cloud Machine Translation"}},"ja":{"stringUnit":{"state":"translated","value":"Alibaba Cloud機械翻訳"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"阿里云机器翻译"}}}},
