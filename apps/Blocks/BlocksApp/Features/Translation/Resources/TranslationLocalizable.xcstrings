    "translation.plugin.secret.missing" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Required credential is not configured"}},"ja":{"stringUnit":{"state":"translated","value":"必要な認証情報が未設定です"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未配置所需凭据"}}}},
    "translation.plugin.secret.placeholder" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter credential"}},"ja":{"stringUnit":{"state":"translated","value":"認証情報を入力"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"输入凭据"}}}},
    "translation.plugin.secret.saved" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credential saved"}},"ja":{"stringUnit":{"state":"translated","value":"認証情報を保存しました"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"凭据已保存"}}}},
    "translation.plugin.secret.savedRequiresValidation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credential saved to Keychain. The plugin remains disabled until it passes a connection test with this credential."}},"ja":{"stringUnit":{"state":"translated","value":"認証情報をキーチェーンに保存しました。この認証情報で接続テストに成功するまでプラグインは無効のままです。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"凭据已保存到钥匙串。使用该凭据通过连接测试前，插件保持停用。"}}}},
    "translation.plugin.sessionCredential.riskTitle" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Full-session credential"}},"ja":{"stringUnit":{"state":"translated","value":"完全なログインセッションの資格情報"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"完整登录会话凭据"}}}},
    "translation.plugin.sessionCredential.warning" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This credential may represent a complete signed-in session. Blocks never reads browser cookies or refreshes it automatically, and sends it only to: %@."}},"ja":{"stringUnit":{"state":"translated","value":"この資格情報は完全なログインセッションを表す可能性があります。Blocks はブラウザ Cookie を読み取らず、自動更新もせず、次の宛先にのみ送信します：%@。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该凭据可能代表完整登录会话。Blocks 不读取浏览器 Cookie、不自动刷新，只会发送到：%@。"}}}},
