    "translation.dictionary.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dictionary downloads, enabled sources, and source ordering are managed by the system Dictionary app."}},"ja":{"stringUnit":{"state":"translated","value":"辞書のダウンロード、有効なソース、並び順はシステムの「辞書」App で管理します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"词典下载、启用来源和来源排序由系统“词典”App 管理。"}}}},
