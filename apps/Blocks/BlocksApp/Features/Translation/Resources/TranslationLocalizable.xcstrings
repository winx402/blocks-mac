    "translation.service.community.google.web" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Google Web (Community)"}},"ja":{"stringUnit":{"state":"translated","value":"Google Web（コミュニティ）"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Google 网页翻译（社区）"}}}},
    "translation.service.community.mymemory" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MyMemory"}},"ja":{"stringUnit":{"state":"translated","value":"MyMemory"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MyMemory"}}}},
