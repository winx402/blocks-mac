    "translation.selection.selectionTooLarge" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selection is too large to translate in one request. Shorten it and try again."}},"ja":{"stringUnit":{"state":"translated","value":"選択範囲が大きすぎます。短くしてからもう一度お試しください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选中文字过长，请缩短后重试。"}}}},
    "translation.selection.targetExited" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The source app changed or closed before the selection could be read."}},"ja":{"stringUnit":{"state":"translated","value":"選択テキストを読み取る前に、元のアプリが切り替わったか終了しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"读取选区前，来源 App 已切换或退出。"}}}},
    "translation.selection.timedOut" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reading the current selection timed out. You can enter text manually and try again."}},"ja":{"stringUnit":{"state":"translated","value":"選択テキストの読み取りがタイムアウトしました。手動で入力して再試行できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"读取选区超时，你可以先手动输入并重试。"}}}},
    "translation.selection.unavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No readable selected text was found. You can enter text manually."}},"ja":{"stringUnit":{"state":"translated","value":"読み取り可能な選択テキストが見つかりません。テキストを手動で入力できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未读取到可用的选中文字，你可以手动输入文字。"}}}},
    "translation.selection.openPermissions" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Permissions"}},"ja":{"stringUnit":{"state":"translated","value":"権限設定を開く"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开权限设置"}}}},
    "translation.plugin.actions" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plugin actions"}},"ja":{"stringUnit":{"state":"translated","value":"プラグイン操作"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件操作"}}}},
    "translation.plugin.configuration" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Configure plugin"}},"ja":{"stringUnit":{"state":"translated","value":"プラグインを設定"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置插件"}}}},
    "translation.plugin.configurationEmpty" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No ordinary configuration"}},"ja":{"stringUnit":{"state":"translated","value":"通常の設定項目はありません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有普通配置项"}}}},
    "translation.plugin.configurationEmpty.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sensitive fields are configured separately and stored in Keychain."}},"ja":{"stringUnit":{"state":"translated","value":"機密フィールドは別に設定され、キーチェーンに保存されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"敏感字段需单独配置，并存储在钥匙串。"}}}},
    "translation.plugin.configurationHelp" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open configuration help"}},"ja":{"stringUnit":{"state":"translated","value":"設定ヘルプを開く"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开配置帮助"}}}},
    "translation.plugin.configurationRequired" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Complete required configuration"}},"ja":{"stringUnit":{"state":"translated","value":"必須設定を入力してください"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请补全必填配置"}}}},
    "translation.plugin.configurationRequired.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a valid value for “%@” before saving."}},"ja":{"stringUnit":{"state":"translated","value":"保存する前に「%@」へ有効な値を入力してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存前请为“%@”填写有效内容。"}}}},
    "translation.plugin.configurationSavedRequiresValidation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Configuration saved. The plugin remains disabled until the current configuration passes a connection test."}},"ja":{"stringUnit":{"state":"translated","value":"設定を保存しました。現在の設定で接続テストに成功するまでプラグインは無効のままです。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置已保存。当前配置通过连接测试前，插件保持停用。"}}}},
    "translation.plugin.configurationSaveFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not save plugin configuration"}},"ja":{"stringUnit":{"state":"translated","value":"プラグイン設定を保存できませんでした"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件配置保存失败"}}}},
    "translation.plugin.error.missingConfiguration" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Configure the required field before enabling: %@"}},"ja":{"stringUnit":{"state":"translated","value":"有効にする前に必須項目を設定してください：%@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用前请配置必填项：%@"}}}},
    "translation.services.addProfile" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add translation service"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳サービスを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加翻译源"}}}},
    "translation.services.profile.addTitle" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add translation service"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳サービスを追加"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加翻译源"}}}},
    "translation.services.profile.actions" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation service actions"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳サービスの操作"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译源操作"}}}},
    "translation.services.profile.cost.freeTier" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Free tier available"}},"ja":{"stringUnit":{"state":"translated","value":"無料枠あり"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提供免费额度"}}}},
    "translation.services.profile.cost.localFree" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Free on this Mac"}},"ja":{"stringUnit":{"state":"translated","value":"このMacで無料"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地免费"}}}},
    "translation.services.profile.cost.mayBill" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"May incur charges"}},"ja":{"stringUnit":{"state":"translated","value":"料金が発生する場合があります"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可能产生费用"}}}},
    "translation.services.profile.cost.selfHosted" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Self-hostable"}},"ja":{"stringUnit":{"state":"translated","value":"セルフホスト可能"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可自托管"}}}},
    "translation.services.profile.configuration" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Configure translation service"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳サービスを設定"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配置翻译源"}}}},
    "translation.services.profile.credential" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Stored securely in Keychain"}},"ja":{"stringUnit":{"state":"translated","value":"キーチェーンに安全に保存"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安全存储到钥匙串"}}}},
    "translation.services.profile.credentialKeep" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Leave blank to keep current value"}},"ja":{"stringUnit":{"state":"translated","value":"空欄なら現在の値を維持"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"留空则保留当前值"}}}},
    "translation.services.profile.credentialConfigured" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Configured"}},"ja":{"stringUnit":{"state":"translated","value":"設定済み"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已配置"}}}},
    "translation.services.profile.credentialKeepAction" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep"}},"ja":{"stringUnit":{"state":"translated","value":"保持"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保留"}}}},
    "translation.services.profile.credentialPendingRemoval" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Will be removed when saved"}},"ja":{"stringUnit":{"state":"translated","value":"保存時に削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存后移除"}}}},
    "translation.services.profile.credentialRemove" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove credential"}},"ja":{"stringUnit":{"state":"translated","value":"認証情報を削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除凭据"}}}},
    "translation.services.profile.dataRecipient" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation content is sent to %@. Rules verified %@."}},"ja":{"stringUnit":{"state":"translated","value":"翻訳内容は%@に送信されます。規則の確認日：%@。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译内容将发送给 %@；规则核验日期：%@。"}}}},
    "translation.services.profile.delete" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete translation service"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳サービスを削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除翻译源"}}}},
    "translation.services.profile.deleteConfirmation" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete this translation service?"}},"ja":{"stringUnit":{"state":"translated","value":"この翻訳サービスを削除しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除这个翻译源？"}}}},
    "translation.services.profile.editTitle" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit translation service"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳サービスを編集"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑翻译源"}}}},
    "translation.services.profile.externalDataNotice" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"External services receive the text you translate. Credentials stay in Keychain."}},"ja":{"stringUnit":{"state":"translated","value":"外部サービスには翻訳するテキストが送信されます。認証情報はキーチェーンに保存されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"外部服务会收到待翻译文本；凭据仅保存在钥匙串。"}}}},
    "translation.services.profile.field.access_key_id" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AccessKey ID"}},"ja":{"stringUnit":{"state":"translated","value":"AccessKey ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AccessKey ID"}}}},
    "translation.services.profile.field.access_key_secret" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"AccessKey Secret"}},"ja":{"stringUnit":{"state":"translated","value":"AccessKey Secret"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"AccessKey Secret"}}}},
    "translation.services.profile.field.api_key" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"API Key"}},"ja":{"stringUnit":{"state":"translated","value":"APIキー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"API Key"}}}},
    "translation.services.profile.field.auth_key" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Auth Key"}},"ja":{"stringUnit":{"state":"translated","value":"認証キー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Auth Key"}}}},
    "translation.services.profile.field.base_url" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Base URL"}},"ja":{"stringUnit":{"state":"translated","value":"ベースURL"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务地址"}}}},
    "translation.services.profile.field.region" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Region"}},"ja":{"stringUnit":{"state":"translated","value":"リージョン"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"区域"}}}},
    "translation.services.profile.field.subscription_key" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Subscription Key"}},"ja":{"stringUnit":{"state":"translated","value":"サブスクリプションキー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Subscription Key"}}}},
    "translation.services.profile.name" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Name"}},"ja":{"stringUnit":{"state":"translated","value":"名前"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"名称"}}}},
    "translation.services.profile.notValidated" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection not validated"}},"ja":{"stringUnit":{"state":"translated","value":"接続未検証"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接未验证"}}}},
    "translation.services.profile.officialRules" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Official configuration and billing rules"}},"ja":{"stringUnit":{"state":"translated","value":"公式の設定と料金規則"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看官方配置与计费规则"}}}},
    "translation.services.profile.saveFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not save translation service"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳サービスを保存できませんでした"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译源保存失败"}}}},
    "translation.services.profile.saveAndValidate" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Save and Validate"}},"ja":{"stringUnit":{"state":"translated","value":"保存して検証"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存并验证"}}}},
    "translation.services.profile.saved" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation service saved. Validate the connection before enabling it."}},"ja":{"stringUnit":{"state":"translated","value":"翻訳サービスを保存しました。有効にする前に接続を検証してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译源已保存，请先验证连接再启用。"}}}},
    "translation.services.profile.savedValidationFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved, but connection validation failed"}},"ja":{"stringUnit":{"state":"translated","value":"保存しましたが、接続検証に失敗しました"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存，但连接验证失败"}}}},
    "translation.services.profile.savedValidationFailed.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The profile remains disabled. Check the configuration and retry validation. %@"}},"ja":{"stringUnit":{"state":"translated","value":"プロファイルは無効のままです。設定を確認して検証を再試行してください。%@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该翻译源仍保持停用。请检查配置后重新验证。%@"}}}},
    "translation.services.profile.template" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Service"}},"ja":{"stringUnit":{"state":"translated","value":"サービス"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译源"}}}},
    "translation.services.profile.test" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Validate connection"}},"ja":{"stringUnit":{"state":"translated","value":"接続を検証"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"验证连接"}}}},
    "translation.services.profile.testFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection validation failed. Check the configuration, credentials, and service status."}},"ja":{"stringUnit":{"state":"translated","value":"接続の検証に失敗しました。設定、認証情報、サービス状態を確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接验证失败，请检查配置、凭据和服务状态。"}}}},
    "translation.services.profile.testSucceeded" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection validated. This test may count against a free tier or incur charges."}},"ja":{"stringUnit":{"state":"translated","value":"接続を検証しました。このテストは無料枠を消費したり、料金が発生する場合があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接验证成功；本次测试可能消耗免费额度或产生费用。"}}}}
    ,"translation.services.profile.validationDisclosure" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation content is sent to %@. Rules verified %@. “Save and Validate” sends a fixed low-sensitivity test phrase and may consume a free tier or incur charges."}},"ja":{"stringUnit":{"state":"translated","value":"翻訳内容は%@に送信されます。規則の確認日：%@。「保存して検証」は固定の低機密テスト文を送信し、無料枠を消費したり料金が発生する場合があります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译内容将发送给 %@；规则核验日期：%@。“保存并验证”会发送固定的低敏测试文本，可能消耗免费额度或产生费用。"}}}}
    ,"translation.services.profile.enableDisclosure" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation content is sent to %@. Rules verified %@. Saving enables this source without sending a connection-test request; you can test it separately afterward."}},"ja":{"stringUnit":{"state":"translated","value":"翻訳内容は%@に送信されます。規則の確認日：%@。保存すると接続テストを送信せずにこのサービスを有効にします。接続テストは後から個別に実行できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译内容将发送给 %@；规则核验日期：%@。保存后将直接开启此翻译源，不发送连接测试请求；可稍后单独测试连接。"}}}}
    ,"translation.services.profile.validated" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connection validated"}},"ja":{"stringUnit":{"state":"translated","value":"接続検証済み"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"连接已验证"}}}},
    "translation.selectionHelper.codeInvalid" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the six-digit code shown in Blocks Selection Helper."}},"ja":{"stringUnit":{"state":"translated","value":"Blocks Selection Helper に表示される6桁のコードを入力してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入“积木划词翻译助手”中显示的六位配对码。"}}}},
    "translation.selectionHelper.connecting" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connecting…"}},"ja":{"stringUnit":{"state":"translated","value":"接続中…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在连接…"}}}},
    "translation.selectionHelper.disconnect" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Disconnect"}},"ja":{"stringUnit":{"state":"translated","value":"接続を解除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"断开连接"}}}},
    "translation.selectionHelper.download" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Download Helper"}},"ja":{"stringUnit":{"state":"translated","value":"Helper をダウンロード"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载助手"}}}},
    "translation.selectionHelper.downloadUnavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Helper download page is not configured in this build."}},"ja":{"stringUnit":{"state":"translated","value":"このビルドには Helper のダウンロードページが設定されていません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前构建尚未配置助手下载地址。"}}}},
    "translation.selectionHelper.error.connectionFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Helper did not respond. Open it and try again."}},"ja":{"stringUnit":{"state":"translated","value":"Helper から応答がありません。起動して再試行してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"助手没有响应，请打开助手后重试。"}}}},
    "translation.selectionHelper.error.disconnectFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Helper did not confirm disconnection, so Blocks kept the pairing. Reopen the Helper, then choose Recheck to retry the authenticated disconnect."}},"ja":{"stringUnit":{"state":"translated","value":"Helper が接続解除を確認しなかったため、Blocks はペアリングを保持しました。Helper を開いてから「再確認」を選び、認証済みの接続解除を再試行してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"助手未确认断开连接，因此积木工具保留了配对。请打开助手，然后选择“重新检查”以重试已认证的断开连接。"}}}},
    "translation.selectionHelper.error.disconnectRepairRequired" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Blocks could not confirm the old disconnection before recovery expired. Pair again with the Helper’s current code to repair this connection."}},"ja":{"stringUnit":{"state":"translated","value":"復旧期限内に以前の接続解除を確認できませんでした。Helper に表示されている現在のコードで再度ペアリングして、この接続を修復してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在恢复期限内无法确认之前的断开连接。请使用助手当前显示的配对码重新配对，以修复此连接。"}}}},
    "translation.selectionHelper.error.invalidCode" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The pairing code is invalid or expired."}},"ja":{"stringUnit":{"state":"translated","value":"ペアリングコードが無効か期限切れです。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配对码错误或已过期。"}}}},
    "translation.selectionHelper.error.installationConflict" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Another copy of the Helper is running from a different location. Open the current Helper, quit the old copy, or reinstall it, then try again."}},"ja":{"stringUnit":{"state":"translated","value":"別の場所にある Helper が実行中です。現在の Helper を開き、古いコピーを終了するか再インストールしてから、もう一度試してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检测到另一路径的助手正在运行。请打开当前助手、退出旧助手，或重新安装后重试。"}}}},
    "translation.selectionHelper.error.notInstalled" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Blocks Selection Helper is not installed."}},"ja":{"stringUnit":{"state":"translated","value":"Blocks Selection Helper がインストールされていません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未安装“积木划词翻译助手”。"}}}},
    "translation.selectionHelper.error.notPaired" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pair Blocks with the Helper before using selection translation."}},"ja":{"stringUnit":{"state":"translated","value":"選択翻訳を使う前に Blocks と Helper をペアリングしてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用划词翻译前，请先将积木工具与助手配对。"}}}},
    "translation.selectionHelper.error.notRunning" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Blocks Selection Helper is not running."}},"ja":{"stringUnit":{"state":"translated","value":"Blocks Selection Helper が起動していません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“积木划词翻译助手”未运行。"}}}},
    "translation.selectionHelper.error.outdated" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Helper version is incompatible. Download the latest version."}},"ja":{"stringUnit":{"state":"translated","value":"Helper のバージョンに互換性がありません。最新版をダウンロードしてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"助手版本不兼容，请下载最新版。"}}}},
    "translation.selectionHelper.feedback" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selection Helper needs attention"}},"ja":{"stringUnit":{"state":"translated","value":"選択翻訳 Helper を確認してください"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"划词翻译助手需要处理"}}}},
    "translation.selectionHelper.open" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Helper"}},"ja":{"stringUnit":{"state":"translated","value":"Helper を開く"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开助手"}}}},
    "translation.selectionHelper.openFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Could not open Blocks Selection Helper."}},"ja":{"stringUnit":{"state":"translated","value":"Blocks Selection Helper を開けませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法打开“积木划词翻译助手”。"}}}},
    "translation.selectionHelper.openPermissionSettings" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Settings"}},"ja":{"stringUnit":{"state":"translated","value":"設定を開く"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开权限设置"}}}},
    "translation.selectionHelper.pair" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pair"}},"ja":{"stringUnit":{"state":"translated","value":"ペアリング"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配对"}}}},
    "translation.selectionHelper.pairingCode" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pairing code"}},"ja":{"stringUnit":{"state":"translated","value":"ペアリングコード"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"配对码"}}}},
    "translation.selectionHelper.pairingCode.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the six-digit code shown in the Helper. The code expires when the Helper restarts."}},"ja":{"stringUnit":{"state":"translated","value":"Helper に表示される6桁のコードを入力してください。Helper の再起動後は無効になります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"输入助手中显示的六位配对码；助手重启后旧码失效。"}}}},
    "translation.selectionHelper.recheck" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check Again"}},"ja":{"stringUnit":{"state":"translated","value":"再確認"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新检测"}}}},
    "translation.selectionHelper.requestPermission" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Request Access"}},"ja":{"stringUnit":{"state":"translated","value":"アクセスを要求"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请求辅助功能权限"}}}},
    "translation.selectionHelper.state.checking" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking the Helper connection…"}},"ja":{"stringUnit":{"state":"translated","value":"Helper の接続を確認中…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检测助手连接…"}}}},
    "translation.selectionHelper.state.connecting" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Connecting and verifying the secure local channel…"}},"ja":{"stringUnit":{"state":"translated","value":"安全なローカル接続を確認中…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在连接并验证本机安全通道…"}}}},
    "translation.selectionHelper.state.installationConflict" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A Helper from another location is running; no process was closed automatically."}},"ja":{"stringUnit":{"state":"translated","value":"別の場所の Helper が実行中です。プロセスは自動終了されませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"另一路径的助手正在运行；未自动退出任何进程。"}}}},
    "translation.selectionHelper.state.connectionFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The secure local connection failed."}},"ja":{"stringUnit":{"state":"translated","value":"安全なローカル接続に失敗しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机安全连接失败。"}}}},
    "translation.selectionHelper.state.missingPermission" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Helper needs Accessibility permission to read the current selection."}},"ja":{"stringUnit":{"state":"translated","value":"選択範囲を読み取るには Helper にアクセシビリティ権限が必要です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"助手缺少辅助功能权限，无法读取当前选区。"}}}},
    "translation.selectionHelper.state.notInstalled" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install the separate Helper to enable selection translation."}},"ja":{"stringUnit":{"state":"translated","value":"選択翻訳を有効にするには別配布の Helper をインストールしてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装独立助手后才能使用划词翻译。"}}}},
    "translation.selectionHelper.state.notPaired" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Helper is installed but has not been paired with Blocks."}},"ja":{"stringUnit":{"state":"translated","value":"Helper はインストール済みですが Blocks と未ペアリングです。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"助手已安装，但尚未与积木工具配对。"}}}},
    "translation.selectionHelper.state.notRunning" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Helper is installed but not responding."}},"ja":{"stringUnit":{"state":"translated","value":"Helper はインストール済みですが応答していません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"助手已安装，但当前未运行或未响应。"}}}},
    "translation.selectionHelper.state.outdated" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Helper protocol is incompatible with this Blocks version."}},"ja":{"stringUnit":{"state":"translated","value":"Helper のプロトコルはこの Blocks バージョンと互換性がありません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"助手协议与当前积木工具版本不兼容。"}}}},
