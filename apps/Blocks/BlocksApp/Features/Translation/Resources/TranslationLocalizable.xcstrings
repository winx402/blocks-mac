    "translation.services.template.google" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Google Cloud Translation Basic"}},"ja":{"stringUnit":{"state":"translated","value":"Google Cloud Translation Basic"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Google Cloud Translation Basic"}}}},
    "translation.services.template.libre" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"LibreTranslate"}},"ja":{"stringUnit":{"state":"translated","value":"LibreTranslate"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"LibreTranslate"}}}},
    "translation.services.template.microsoft" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Microsoft Translator"}},"ja":{"stringUnit":{"state":"translated","value":"Microsoft Translator"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Microsoft Translator"}}}},
    "translation.services.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation Comparison Group"}},"ja":{"stringUnit":{"state":"translated","value":"翻訳比較グループ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译对照组"}}}},
    "translation.clipboard.unavailable.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This clipboard item does not contain readable text."}},"ja":{"stringUnit":{"state":"translated","value":"このクリップボード項目には読み取り可能なテキストがありません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该剪贴板条目不包含可读取的文字。"}}}},
    "translation.clipboard.unavailable.title" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cannot translate this item"}},"ja":{"stringUnit":{"state":"translated","value":"この項目は翻訳できません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法翻译该条目"}}}},
    "translation.error.appleLanguageNotReady" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple on-device translation is not ready for this language direction yet. Try again shortly or manage system translation languages."}},"ja":{"stringUnit":{"state":"translated","value":"この言語方向のAppleオンデバイス翻訳はまだ準備できていません。しばらくしてから再試行するか、システムの翻訳言語を管理してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 本地翻译尚未准备好当前语言方向，请稍后重试或管理系统翻译语言。"}}}},
    "translation.error.applePreparationFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple on-device translation could not finish preparing. Try again or choose another translation service."}},"ja":{"stringUnit":{"state":"translated","value":"Appleオンデバイス翻訳の準備を完了できませんでした。再試行するか、別の翻訳サービスを選択してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 本地翻译未能完成准备，请重试或切换其他翻译源。"}}}},
    "translation.error.appleRequiresMacOS15" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple on-device translation requires macOS 15 or later."}},"ja":{"stringUnit":{"state":"translated","value":"Appleオンデバイス翻訳にはmacOS 15以降が必要です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 本地翻译需要 macOS 15 或更高版本。"}}}},
    "translation.error.appleRuntimeUnavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple on-device translation is temporarily unavailable. Try again or choose another translation service."}},"ja":{"stringUnit":{"state":"translated","value":"Appleオンデバイス翻訳は一時的に利用できません。再試行するか、別の翻訳サービスを選択してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 本地翻译暂时不可用，请重试或切换其他翻译源。"}}}},
    "translation.error.emptyResult" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The service returned an empty translation."}},"ja":{"stringUnit":{"state":"translated","value":"サービスから空の翻訳結果が返されました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务返回了空译文。"}}}},
    "translation.error.emptySource" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter source text before translating."}},"ja":{"stringUnit":{"state":"translated","value":"翻訳する原文を入力してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先输入需要翻译的原文。"}}}},
    "translation.error.generic" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Translation failed. Try again."}},"ja":{"stringUnit":{"state":"translated","value":"翻訳に失敗しました。もう一度お試しください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译失败，请重试。"}}}},
    "translation.error.inputTooLarge" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The source text is too long. Shorten it to no more than %lld characters and try again."}},"ja":{"stringUnit":{"state":"translated","value":"原文が長すぎます。%lld文字以内に短くして、もう一度お試しください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原文过长，请缩短到 %lld 个字符以内后重试。"}}}},
    "translation.error.languageDownloadRequired" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Download the required Apple language pack to continue."}},"ja":{"stringUnit":{"state":"translated","value":"続行するには必要なApple言語パックをダウンロードしてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请下载所需的 Apple 语言包后继续。"}}}},
    "translation.error.languagePairUnsupported" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This service does not support the selected language pair."}},"ja":{"stringUnit":{"state":"translated","value":"このサービスは選択した言語ペアに対応していません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该服务不支持当前语言组合。"}}}},
    "translation.error.languageUnavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected language is currently unavailable."}},"ja":{"stringUnit":{"state":"translated","value":"選択した言語は現在利用できません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前无法使用所选语言。"}}}},
    "translation.error.missingConfiguration" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Complete the external service configuration before translating."}},"ja":{"stringUnit":{"state":"translated","value":"翻訳する前に外部サービスの設定を完了してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先完成外部翻译服务配置。"}}}},
    "translation.error.pluginCapabilityUnavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This plugin does not provide the requested capability."}},"ja":{"stringUnit":{"state":"translated","value":"このプラグインは要求された機能を提供していません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该插件未提供所需能力。"}}}},
    "translation.error.pluginDisabled" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This plugin is disabled. Enable it in Translation settings."}},"ja":{"stringUnit":{"state":"translated","value":"このプラグインは無効です。翻訳設定で有効にしてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该插件已停用，请在翻译设置中启用。"}}}},
    "translation.error.pluginEmptyOutput" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The translation plugin returned no text."}},"ja":{"stringUnit":{"state":"translated","value":"翻訳プラグインからテキストが返されませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译插件未返回文本。"}}}},
    "translation.error.pluginFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The translation plugin failed. Review its configuration and try again."}},"ja":{"stringUnit":{"state":"translated","value":"翻訳プラグインに失敗しました。設定を確認して再試行してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"翻译插件运行失败，请检查配置后重试。"}}}},
    "translation.error.pluginNetworkFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin network request was blocked or failed."}},"ja":{"stringUnit":{"state":"translated","value":"プラグインのネットワーク要求がブロックされたか、失敗しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件网络请求被拦截或执行失败。"}}}},
    "translation.error.pluginNotApproved" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review and approve this plugin before using it."}},"ja":{"stringUnit":{"state":"translated","value":"使用する前に、このプラグインを確認して承認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先复核并批准该插件。"}}}},
    "translation.error.pluginOCRImageEncodingFailed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The screenshot could not be prepared for the OCR plugin."}},"ja":{"stringUnit":{"state":"translated","value":"OCRプラグイン用にスクリーンショットを準備できませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法为 OCR 插件准备截图。"}}}},
    "translation.error.pluginOCRImageTooLarge" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The screenshot is too large for this OCR plugin."}},"ja":{"stringUnit":{"state":"translated","value":"このスクリーンショットはOCRプラグインには大きすぎます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该截图超出 OCR 插件可处理的大小。"}}}},
    "translation.error.pluginPackageChanged" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This plugin changed after approval. Review it again before use."}},"ja":{"stringUnit":{"state":"translated","value":"承認後にプラグインが変更されました。使用前に再確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该插件在批准后发生变化，请重新复核。"}}}},
    "translation.error.pluginRunnerUnavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The isolated plugin runner is unavailable in this build."}},"ja":{"stringUnit":{"state":"translated","value":"このビルドでは分離プラグインランナーを利用できません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前构建中无法使用隔离插件运行器。"}}}},
    "translation.error.pluginStopped" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Blocks stopped the plugin because its output or runtime behavior was invalid."}},"ja":{"stringUnit":{"state":"translated","value":"出力または実行動作が無効だったため、Blocksがプラグインを停止しました。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件输出或运行行为异常，Blocks 已终止执行。"}}}},
    "translation.error.serviceUnavailable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This translation service is unavailable."}},"ja":{"stringUnit":{"state":"translated","value":"この翻訳サービスは利用できません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该翻译服务当前不可用。"}}}},
    "translation.error.sourceLanguageUndetermined" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The source language could not be detected. Choose it manually."}},"ja":{"stringUnit":{"state":"translated","value":"原文の言語を検出できませんでした。手動で選択してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法识别原文语言，请手动选择。"}}}},
    "translation.error.sourceLanguageUnsupported" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple on-device translation does not support the selected source language. Choose another source language."}},"ja":{"stringUnit":{"state":"translated","value":"Appleオンデバイス翻訳は選択した原文言語に対応していません。別の原文言語を選択してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 本地翻译不支持当前原文语言，请更换原文语言。"}}}},
