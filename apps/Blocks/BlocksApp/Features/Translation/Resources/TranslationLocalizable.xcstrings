    "translation.rememberLastTargetLanguage.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the most recently selected target language for the next session."}},"ja":{"stringUnit":{"state":"translated","value":"次のセッションで直前に選択した翻訳先言語を使用します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下次会话优先使用最近一次选择的目标语言。"}}}},
