    "translation.language.focus.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"When the source is your native language, Blocks translates to the most recently used language in this ordered list."}},"ja":{"stringUnit":{"state":"translated","value":"原文が母語の場合、この並び順の中で直近に使用した言語へ翻訳します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原文为母语时，优先翻译为此有序列表中最近使用的语言。"}}}},
