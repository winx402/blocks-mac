    "translation.plugin.runtimeUnavailable.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ could not be loaded for %@. The saved selection is preserved, but this service remains unavailable until you review it or choose another service."}},"ja":{"stringUnit":{"state":"translated","value":"%@を%@用に読み込めませんでした。保存済みの選択は保持されますが、再確認するか別のサービスを選ぶまで利用できません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法加载 %@ 的 %@ 能力。已保留原配置；请重新复核该插件或选择其他服务。"}}}},
    "translation.plugin.rowDetail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Version %@ · %@ · %@"}},"ja":{"stringUnit":{"state":"translated","value":"バージョン %@ · %@ · %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"版本 %@ · %@ · %@"}}}},
