    "translation.plugin.riskDetail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Native plugins run JavaScript in an isolated service. Review the package hash, capabilities, domains, and credential declarations before installing."}},"ja":{"stringUnit":{"state":"translated","value":"ネイティブプラグインは隔離サービス内でJavaScriptを実行します。インストール前にハッシュ、機能、ドメイン、資格情報の宣言を確認してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原生插件会在隔离服务中运行 JavaScript。安装前请核对包哈希、能力、外发域名和凭据声明。"}}}},
    "translation.plugin.riskTitle" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Third-party plugin code"}},"ja":{"stringUnit":{"state":"translated","value":"サードパーティ製プラグインコード"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"第三方插件代码"}}}},
