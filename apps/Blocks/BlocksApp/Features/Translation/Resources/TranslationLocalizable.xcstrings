    "translation.language.noFocusConfigured" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add at least one language of interest before using smart target detection."}},"ja":{"stringUnit":{"state":"translated","value":"スマートな翻訳先を使用するには、注目する言語を1つ以上追加してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先添加至少一种关注语言，再使用智能目标语言。"}}}},
