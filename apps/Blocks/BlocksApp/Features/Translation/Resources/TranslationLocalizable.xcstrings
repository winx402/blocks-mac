    "translation.selection.compatibility.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage apps allowed to use temporary copy when Accessibility cannot read the selection."}},"ja":{"stringUnit":{"state":"translated","value":"アクセシビリティから選択範囲を読み取れない場合に、一時コピーを許可するアプリを管理します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"管理在辅助功能无法读取选区时，可使用临时复制取词的应用。"}}}},
