    "translation.plugin.installed" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plugin reviewed, installed, and enabled"}},"ja":{"stringUnit":{"state":"translated","value":"プラグインを確認し、インストールして有効にしました"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件已复核、安装并启用"}}}},
    "translation.plugin.installedNeedsConfiguration" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The plugin is installed and remains disabled. Configure it, run a successful connection test, then enable it."}},"ja":{"stringUnit":{"state":"translated","value":"プラグインはインストールされましたが無効のままです。設定し、接続テストに成功してから有効にしてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"插件已安装并保持停用。请完成配置和连接测试，成功后再启用。"}}}},
