    "translation.selection.unsupportedChannel.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This channel cannot read selected text. Switched to manual input; you can use Screenshot Translation."}},"ja":{"stringUnit":{"state":"translated","value":"この配布チャネルでは選択したテキストを読み取れないため、手入力に切り替えました。スクリーンショット翻訳を使用できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前渠道不支持划词读取，已切换手动输入，可使用截图翻译。"}}}},
