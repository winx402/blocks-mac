    "translation.community.confirmation.detail" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Source text is sent to a non-official community web interface. It may be rate-limited, change, or stop working without notice. No credentials or persistent cookies are used."}},"ja":{"stringUnit":{"state":"translated","value":"原文は非公式のコミュニティWebインターフェイスへ送信されます。予告なく制限、変更、停止される場合があります。認証情報や永続Cookieは使用しません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原文会发送到非官方社区网页接口；接口可能限流、变更或失效。Blocks 不会使用凭据或持久 Cookie。"}}}},
    "translation.community.confirmation.enable" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable Source"}},"ja":{"stringUnit":{"state":"translated","value":"ソースを有効にする"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认启用"}}}},
