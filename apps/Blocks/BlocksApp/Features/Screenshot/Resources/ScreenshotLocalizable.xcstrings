    "screenshot.countdown.accessibility.help": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Press Escape to cancel."}},"ja":{"stringUnit":{"state":"translated","value":"Escape キーでキャンセルします。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按 Esc 取消。"}}}},
    "screenshot.scrolling.permission.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Input Monitoring required"}},"ja":{"stringUnit":{"state":"translated","value":"入力監視が必要です"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要输入监控权限"}}}},
    "screenshot.scrolling.permission.required": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Scrolling capture needs Input Monitoring to detect manual scrolling."}},"ja":{"stringUnit":{"state":"translated","value":"手動スクロールを検出するには入力監視の許可が必要です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"长截图需要输入监控权限来识别手动滚动。"}}}},
    "screenshot.scrolling.cancel.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Discard scrolling capture?"}},"ja":{"stringUnit":{"state":"translated","value":"スクロールキャプチャを破棄しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"丢弃本次长截图？"}}}},
    "screenshot.scrolling.cancel.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Captured content will be deleted and no image will be output."}},"ja":{"stringUnit":{"state":"translated","value":"取得済みの内容は削除され、画像は出力されません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已采集内容将被删除，不会输出图片。"}}}},
    "screenshot.scrolling.warning.size": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Approaching the safe image size limit."}},"ja":{"stringUnit":{"state":"translated","value":"安全な画像サイズの上限に近づいています。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"即将达到安全尺寸上限。"}}}},
    "screenshot.scrolling.warning.limitReached": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Size limit reached. Finalizing valid content."}},"ja":{"stringUnit":{"state":"translated","value":"サイズ上限に達したため、有効な内容を生成します。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已达到尺寸上限，正在生成有效内容。"}}}},
    "screenshot.scrolling.warning.frameChanged": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The capture region changed. Return to the last valid position."}},"ja":{"stringUnit":{"state":"translated","value":"取得範囲が変化しました。最後の有効位置に戻ってください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"采集区域发生变化，请滚回最后有效位置。"}}}},
    "screenshot.scrolling.warning.ambiguous": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Overlap is ambiguous. Return to the last valid position."}},"ja":{"stringUnit":{"state":"translated","value":"重なりを特定できません。最後の有効位置に戻ってください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重叠位置不明确，请滚回最后有效位置。"}}}},
    "screenshot.scrolling.warning.reverse": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reverse scrolling detected. Return to the last valid position."}},"ja":{"stringUnit":{"state":"translated","value":"逆方向のスクロールを検出しました。最後の有効位置に戻ってください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检测到反向滚动，请滚回最后有效位置。"}}}},
    "screenshot.scrolling.warning.fast": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not enough overlap. Scroll back and continue more slowly."}},"ja":{"stringUnit":{"state":"translated","value":"重なりが不足しています。戻ってゆっくり続けてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重叠不足，请滚回并放慢滚动速度。"}}}},
    "screenshot.scrolling.error.sessionActive": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A scrolling capture is already active."}},"ja":{"stringUnit":{"state":"translated","value":"スクロールキャプチャはすでに実行中です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已有长截图会话正在运行。"}}}},
    "screenshot.scrolling.error.noSession": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No scrolling capture is active."}},"ja":{"stringUnit":{"state":"translated","value":"実行中のスクロールキャプチャはありません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前没有长截图会话。"}}}},
    "screenshot.scrolling.error.confirmationRequired": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirmation is required to discard captured content."}},"ja":{"stringUnit":{"state":"translated","value":"取得済み内容の破棄には確認が必要です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"丢弃已采集内容需要确认。"}}}},
    "screenshot.scrolling.error.insufficientContent": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"There is not enough captured content to create an image."}},"ja":{"stringUnit":{"state":"translated","value":"画像を生成するための内容が不足しています。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"采集内容不足，无法生成长图。"}}}},
