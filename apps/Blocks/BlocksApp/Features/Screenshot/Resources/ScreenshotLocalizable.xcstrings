    "screenshot.history.saveFailedDetail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The screenshot was copied, but could not be saved to history."}},"ja":{"stringUnit":{"state":"translated","value":"コピーされましたが、履歴に保存できませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"截图已复制，但未能保存到历史。"}}}},
    "status.editingContextUnavailable.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This capture was not copied. Take another screenshot."}},"ja":{"stringUnit":{"state":"translated","value":"このスクリーンショットはコピーされませんでした。もう一度撮影してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本次截图未复制，请重新截图。"}}}},
    "status.editingContextUnavailable.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unable to prepare quick overlay editing"}},"ja":{"stringUnit":{"state":"translated","value":"クイック編集を準備できません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法准备原屏快编"}}}},
