{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blocks.local/schemas/actions/blocks.clipboard.search.output.schema.json",
  "title": "blocks.clipboard.search output",
  "type": "object",
  "required": [
    "items",
    "truncated"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "created_at",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "rich_text",
              "image",
              "link",
              "file"
            ]
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "truncated": {
      "type": "boolean"
    }
  }
}
