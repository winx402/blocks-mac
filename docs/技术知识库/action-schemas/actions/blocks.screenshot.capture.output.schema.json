{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blocks.local/schemas/actions/blocks.screenshot.capture.output.schema.json",
  "title": "blocks.screenshot.capture output",
  "type": "object",
  "required": [
    "capture_id",
    "mode",
    "image_available"
  ],
  "additionalProperties": false,
  "properties": {
    "capture_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "region",
        "window",
        "fullscreen"
      ]
    },
    "image_available": {
      "type": "boolean"
    }
  }
}
