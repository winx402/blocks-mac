{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blocks.local/schemas/actions/blocks.translate.text.input.schema.json",
  "title": "blocks.translate.text input",
  "type": "object",
  "required": [
    "text",
    "target_language"
  ],
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source_language": {
      "type": "string",
      "default": "auto"
    },
    "target_language": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "default": "mock"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "selection",
        "clipboard",
        "screenshot"
      ],
      "default": "manual"
    }
  }
}
