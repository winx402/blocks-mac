{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blocks.local/schemas/actions/blocks.clipboard.search.input.schema.json",
  "title": "blocks.clipboard.search input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "default": ""
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    },
    "include_content": {
      "type": "boolean",
      "default": false
    }
  }
}
