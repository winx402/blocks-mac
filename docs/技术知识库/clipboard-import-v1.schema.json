{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blocks clipboard content migration v1",
  "$comment": "Runtime additionally enforces 32 MiB UTF-8 encoded document size, payload byte/pixel limits, safe RTF, name normalization and grouping conflicts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "pinboards": { "type": ["array", "null"], "maxItems": 1000, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "records": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "record": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "enum": ["text", "url", "rich_text", "image", "file_url"] },
        "text": { "type": ["string", "null"], "maxLength": 4194304 },
        "url": { "type": ["string", "null"], "maxLength": 4194304 },
        "rtf_base64": { "type": ["string", "null"], "contentEncoding": "base64" },
        "png_base64": { "type": ["string", "null"], "contentEncoding": "base64" },
        "file_urls": { "type": ["array", "null"], "minItems": 1, "maxItems": 1, "items": { "type": "string", "pattern": "^[Ff][Ii][Ll][Ee]:" } },
        "pinboard": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
        "tags": { "type": ["array", "null"], "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "title": { "type": ["string", "null"], "maxLength": 4096 },
        "created_at": { "type": ["string", "null"], "format": "date-time" },
        "last_copied_at": { "type": ["string", "null"], "format": "date-time" },
        "is_favorite": { "type": ["boolean", "null"] }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "text" } } }, "then": { "required": ["text"], "properties": { "text": { "type": "string" } } } },
        { "if": { "properties": { "kind": { "const": "url" } } }, "then": { "anyOf": [{ "required": ["url"], "properties": { "url": { "type": "string" } } }, { "required": ["text"], "properties": { "text": { "type": "string" } } }] }, "else": { "properties": { "url": { "type": "null" } } } },
        { "if": { "properties": { "kind": { "const": "rich_text" } } }, "then": { "required": ["rtf_base64"], "properties": { "rtf_base64": { "type": "string" } } }, "else": { "properties": { "rtf_base64": { "type": "null" } } } },
        { "if": { "properties": { "kind": { "const": "image" } } }, "then": { "required": ["png_base64"], "properties": { "png_base64": { "type": "string" } } }, "else": { "properties": { "png_base64": { "type": "null" } } } },
        { "if": { "properties": { "kind": { "const": "file_url" } } }, "then": { "required": ["file_urls"], "properties": { "file_urls": { "type": "array" } } }, "else": { "properties": { "file_urls": { "type": "null" } } } }
      ]
    }
  }
}
